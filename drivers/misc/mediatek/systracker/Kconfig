config MTK_SYSTRACKER_V2
	bool "Enable MTK System Tracker Debugger V2"
	help
	  SYSTRACKER driver is a debugging feature.
	  SYSTRACKER is a hardware debugger to record timeout transaction
	  and trigger SLV_ERR or interrupt to notify CPU.
	  Support 2 stage timeout & watchpoint SLV_ERR

config MTK_SYSTRACKER_MT6890
	bool "Systracker driver for MediaTek MT6880"
	help
	  SYSTRACKER driver is a debugging feature.
	  If you wish to use this debug resource from the MT6880 SOC,
	  say Y. Otherwise, pls say N.

config MTK_SYSTRACKER_MT6880
	bool "Systracker driver for MediaTek MT6890"
	help
	  SYSTRACKER driver is a debugging feature.
	  If you wish to use this debug resource from the MT6890 SOC,
	  say Y. Otherwise, pls say N.
