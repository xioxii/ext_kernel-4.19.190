/*************************
 * PMIC LED DTSI File
*************************/
// Begin: FG360 boot time management, Add by Shuai Liu, 2021.06.11
&pmic {
	mt6330-led {
		compatible = "mediatek,mt6330_leds";
		Isink1 {
			reg = <1>;
			label = "led9515:green:cellular-radio";
			linux,default-trigger = "none";
			default-state = "off";
		};
	};
};
// End: FG360 boot time management, Add by Shuai Liu, 2021.06.11

&gpio_leds {
	    led0 {
            label = "wifi_led";
            gpios = <&pio 4 GPIO_ACTIVE_HIGH>;
            linux,default-trigger = "none";
            default-state = "off";
        };
	    led1 {
            label = "status_led";
            gpios = <&pio 22 GPIO_ACTIVE_HIGH>;
            linux,default-trigger = "none";
            default-state = "off";
        };
	    led2 {
            label = "5g_led";
            gpios = <&pio 8 GPIO_ACTIVE_HIGH>;
            linux,default-trigger = "none";
            default-state = "off";
        };
	    led3 {
            label = "4g_led";
            gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
            linux,default-trigger = "none";
            default-state = "off";
        };
};

/*begin: add for RST WPS button by laizhenhao,2021.3.27*/
&gpio_keys {
	button0 {
		label = "RST";
		gpios = <&pio 7 GPIO_ACTIVE_LOW>;
		linux,code = <246>;
	};
	button1 {
		label = "WPS";
		gpios = <&pio 20 GPIO_ACTIVE_LOW>;
		linux,code = <115>;
	};
};
/*end: add for RST WPS button by laizhenhao,2021.3.27*/

