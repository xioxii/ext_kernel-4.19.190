/*<!-- BEGIN: fibocom modified-->  */
&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	spi0@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <6000000>;
	};
};
/*<!-- END: fibocom modified-->  */


&spi3 {
	status = "okay";
	#address-cells=<1>;
	#size-cells=<0>;

	proslic_spi: proslic_spi@0 {
		compatible = "silabs,proslic_spi";
		reg = <0>;
		spi-max-frequency = <24000000>;
		spi-cpha = <1>;
		spi-cpol = <1>;
		channel_count = <1>;
		debug_level = <7>;       /* 1 = TRC, 2 = DBG, 4 = ERR */
		reset_gpio = <&pio 23 0>;       /* Hz */
		ig,enable-spi = <1>;                /* 1: Enable, 0: Disable */
	};
};

/*begin: modify audio codec function,by laizhenhao,2021.05.31*/
&i2c0 {
	status = "okay";
	#address-cells=<1>;
	#size-cells=<0>;

	nau88c22: nau88c22@1a {
		compatible = "nuvoton,nau88c22";
		reg = <0x1a>;
	};

};
/*end: modify audio codec function,by laizhenhao,2021.05.31*/

